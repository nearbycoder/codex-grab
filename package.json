{
  "name": "codex-grab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo-vite"
  ],
  "scripts": {
    "build": "npm run build -w @codex-grab/core -- --force && npm run build -w @codex-grab/react -- --force && npm run build -w @codex-grab/demo-shell -- --force && npm run build -w @codex-grab/bridge -- --force && npm run build -w demo-vite",
    "changeset": "changeset",
    "dev:demo": "npm run dev -w demo-vite",
    "dev:bridge": "npm run dev -w @codex-grab/bridge",
    "dev:all": "node ./scripts/dev-all.mjs",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc -b --pretty false",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
