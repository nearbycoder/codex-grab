{
  "name": "@codex-grab/react",
  "version": "0.1.0",
  "description": "React provider, overlay, widgets, and hooks for codex-grab.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearbycoder/codex-grab.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/nearbycoder/codex-grab/tree/main/packages/react",
  "bugs": {
    "url": "https://github.com/nearbycoder/codex-grab/issues"
  },
  "keywords": [
    "codex",
    "react",
    "overlay",
    "developer-tools"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codex-grab/core": "0.1.0",
    "@pierre/diffs": "^1.2.11",
    "motion": "^12.41.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
