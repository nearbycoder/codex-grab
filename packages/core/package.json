{
  "name": "@codex-grab/core",
  "version": "0.1.0",
  "description": "Core selection, serialization, and bridge protocol types for codex-grab.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearbycoder/codex-grab.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nearbycoder/codex-grab/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/nearbycoder/codex-grab/issues"
  },
  "keywords": [
    "codex",
    "react",
    "overlay",
    "developer-tools"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bippy": "^0.5.30"
  }
}
